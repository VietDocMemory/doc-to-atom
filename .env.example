# OpenAI SDK configuration for MiniMax (required only for NEW API requests).
OPENAI_BASE_URL=https://api.minimax.io/v1
OPENAI_API_KEY=

# Backward-compatible MiniMax credential; takes precedence when non-empty.
MINIMAX_API_KEY=

# Optional: access to gated base-model weights, not annotation authentication.
HF_TOKEN=

# Optional: only if experiment tracking is explicitly set to online.
# WANDB_API_KEY=

# Choose annotator via CLI --model, not credential/provider environment variables.
# Default: MiniMax-M3.1-Flash; paper annotator: MiniMax-M2.5.
